{
  "name": "mobile-ui-template",
  "private": true,
  "version": "0.0.0",
  "description": "Example CSR mobile-app UI built entirely from @nebula-lab/react-ui + @nebula-lab/react-ui-blocks — a starting point to fork, not a published package.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nebula-lab/primitives": "workspace:*",
    "@nebula-lab/react-ui": "workspace:*",
    "@nebula-lab/react-ui-blocks": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
